module systolic_array #(parameter N = 4) (
    input wire clk,
    input wire rst_n,
    input wire en,
    input wire [(N*16)-1:0] a_left_in, 
    input wire [(N*16)-1:0] b_top_in,
    output wire [(N*N*16)-1:0] c_matrix_out
);
    wire [15:0] a_wire [0:N][0:N];
    wire [15:0] b_wire [0:N][0:N];

    genvar k;
    generate
        for (k = 0; k < N; k = k + 1) begin : edges
            assign a_wire[k][0] = a_left_in[(k*16) +: 16]; 
            assign b_wire[0][k] = b_top_in[(k*16) +: 16];  
        end
    endgenerate

    genvar i, j;
    generate
        for (i = 0; i < N; i = i + 1) begin : row
            for (j = 0; j < N; j = j + 1) begin : col
                pe_fp16 pe_inst (
                    .clk(clk),
                    .rst_n(rst_n),
                    .en(en),
                    .a_in  (a_wire[i][j]),       
                    .b_in  (b_wire[i][j]),       
                    .a_out (a_wire[i][j+1]),     
                    .b_out (b_wire[i+1][j]),     
                    .c_out (c_matrix_out[ ((i*N + j)*16) +: 16 ]) 
                );
            end
        end
    endgenerate
endmodule